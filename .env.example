# ── Telegram ──────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF_replace_me
# ID администраторов через запятую (узнать свой ID можно у @userinfobot)
ADMIN_IDS=111111111,222222222
# Чат, куда падают уведомления о новых заявках.
# Если пусто — уведомления шлются каждому админу из ADMIN_IDS в личку.
NOTIFY_CHAT_ID=

# ── База данных ───────────────────────────────────────────────────────────
# Prod (docker compose): postgresql+asyncpg://leadbot:leadbot@postgres:5432/leadbot
# Локально без Docker:   sqlite+aiosqlite:///./leadbot.sqlite3
DATABASE_URL=postgresql+asyncpg://leadbot:leadbot@postgres:5432/leadbot

# ── Redis (хранилище FSM) ─────────────────────────────────────────────────
# Если пусто — используется MemoryStorage (состояния теряются при рестарте)
REDIS_URL=redis://redis:6379/0

# ── Прочее ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Антифлуд: минимальный интервал между сообщениями одного пользователя, сек
THROTTLE_RATE=0.5
